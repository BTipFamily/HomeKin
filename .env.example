# Supabase — copy values from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for auth redirects and Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — for emails (stub with console logging until set up)
RESEND_API_KEY=

# Stripe — Phase 2 only
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mapbox — used by the Family Tree/Travel Map feature. Create two separate
# tokens in your Mapbox account (account.mapbox.com/access-tokens):
#  - a PUBLIC token, URL-restricted to your app's domain, for client-side
#    map rendering
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoid2lsbHRpcCIsImEiOiJjbXJyaDE5cGwxZ2ExMndvajl3aThjd3BoIn0.pIN9l9hnLLxNxUjpf2_tmA
#  - a SECRET token (never exposed to the browser), scoped to `geocoding`,
#    for server-side address -> lat/lng lookups on profile/reunion save
MAPBOX_SECRET_TOKEN=sk.eyJ1Ijoid2lsbHRpcCIsImEiOiJjbXJyaGhyYnoyeGUyNHVvYWVueWc0eHBtIn0._rWsHBCfysaMKu9dHS7Idw
