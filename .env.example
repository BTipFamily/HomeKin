# Supabase — copy values from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for auth redirects and Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email — invite codes, RSVP invitations, announcements and the signup
# confirmation email, all sent over SMTP. Defaults to Gmail, which needs no
# domain of your own: turn on 2-step verification at myaccount.google.com, then
# create an app password (Security > 2-Step Verification > App passwords) and
# paste the 16 characters below. Free Gmail allows 500 recipients a day.
#
# Without SMTP_USER and SMTP_PASS nothing HomeKin sends is delivered; the app
# says so rather than reporting success. Signup confirmation also needs
# SUPABASE_SERVICE_ROLE_KEY; without both it falls back to Supabase Auth's
# built-in sender, which rate-limits you to a few messages an hour and lands in
# spam.
SMTP_USER=you@gmail.com
SMTP_PASS=
# Defaults: smtp.gmail.com on port 587 (STARTTLS). Port 465 switches to
# implicit TLS automatically; SMTP_SECURE=true/false overrides that.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=

# Optional display name. Gmail rejects or rewrites a From it did not
# authenticate, so the address here must be SMTP_USER — only the name is yours
# to choose. Left blank, SMTP_USER is used as-is.
EMAIL_FROM=HomeKin <you@gmail.com>

# Resend — commented out in favour of Gmail SMTP above (see src/lib/email.ts).
# The better option once you own a domain: no daily quota, real bounce handling,
# and a From that is not a personal mailbox.
# RESEND_API_KEY=

# Stripe — Phase 2 only
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mapbox — used by the Family Tree/Travel Map feature. Create two separate
# tokens in your Mapbox account (account.mapbox.com/access-tokens):
#  - a PUBLIC token, URL-restricted to your app's domain, for client-side
#    map rendering
NEXT_PUBLIC_MAPBOX_TOKEN=
#  - a SECRET token (never exposed to the browser), scoped to `geocoding`,
#    for server-side address -> lat/lng lookups on profile/reunion save
MAPBOX_SECRET_TOKEN=
