# Supabase — copy values from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for auth redirects and Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — invite-code emails, RSVP invitations.
# Without it nothing is delivered; the app now says so rather than reporting
# success. Note this does NOT cover the signup confirmation email, which is sent
# by Supabase Auth — configure custom SMTP under Auth > Emails in Supabase, or
# its built-in sender will rate-limit you to a few messages an hour and land in
# spam.
RESEND_API_KEY=
EMAIL_FROM=HomeKin <noreply@yourdomain.com>

# Stripe — Phase 2 only
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mapbox — used by the Family Tree/Travel Map feature. Create two separate
# tokens in your Mapbox account (account.mapbox.com/access-tokens):
#  - a PUBLIC token, URL-restricted to your app's domain, for client-side
#    map rendering
NEXT_PUBLIC_MAPBOX_TOKEN=
#  - a SECRET token (never exposed to the browser), scoped to `geocoding`,
#    for server-side address -> lat/lng lookups on profile/reunion save
MAPBOX_SECRET_TOKEN=
