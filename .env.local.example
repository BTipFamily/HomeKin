# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (TEST keys — never commit real keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email over SMTP, Gmail by default (optional — stubs to console.log when unset).
# SMTP_PASS is a Google app password, not your account password.
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=HomeKin <you@gmail.com>

# Resend — commented out in favour of Gmail SMTP (see src/lib/email.ts)
# RESEND_API_KEY=re_...

# Mapbox (Family Tree/Travel Map) — public token for the client-side map,
# secret token (geocoding scope) for server-side address lookups
NEXT_PUBLIC_MAPBOX_TOKEN=pk...
MAPBOX_SECRET_TOKEN=sk...
